# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173
ENABLE_API_DOCS=true
LOG_LEVEL=INFO

# MongoDB
MONGODB_URI=
MONGODB_DATABASE=resume_fit_ai
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=45

# Private AWS S3 storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=20

# Firebase Admin (backend only)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# Limits
MAX_UPLOAD_SIZE_MB=5
MAX_JSON_BODY_BYTES=1000000
PRESIGNED_URL_EXPIRY_SECONDS=900
RATE_LIMIT_AUTHENTICATED=120
RATE_LIMIT_AI=10
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_PDF=10
RATE_LIMIT_WINDOW_SECONDS=60
